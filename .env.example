# Root-level reference of shared environment variables.
# Real per-app env files live in apps/api/.env and apps/mobile/.env (see .env.example in each).

# --- Database ---
DATABASE_URL=postgresql://fitness:fitness@localhost:5433/fitness_app

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-long-random-string

# --- API server ---
PORT=4000

# --- Mock mode (set to false only once real providers below are configured) ---
MOCK_AI=true
MOCK_SPEECH=true
MOCK_NUTRITION=true
MOCK_HEALTH_DATA=true

# --- Real provider credentials (optional, leave blank to stay in mock mode) ---

# Which AI backend is live when MOCK_AI=false: "openai" or "azure".
# Both blocks below can be filled in at the same time — this one line picks
# the active one, so switching is a one-word edit plus a restart rather than
# swapping credentials in and out.
AI_PROVIDER=openai

# --- OpenAI (used when AI_PROVIDER=openai) ---
AI_API_KEY=
# gpt-4o-mini is the cheapest vision tier and is noticeably weaker at
# identifying specific dishes from a photo; gpt-4o is the recommended
# default if meal-photo recognition matters.
AI_MODEL=gpt-4o
# Leave unset for api.openai.com. Set only to point at some other
# OpenAI-compatible endpoint; for Azure prefer AI_PROVIDER=azure below.
AI_BASE_URL=
# Legacy Azure-via-AI_BASE_URL support; prefer AZURE_OPENAI_API_VERSION.
AI_AZURE_API_VERSION=

# --- Azure OpenAI (used when AI_PROVIDER=azure) ---
# ENDPOINT is the BASE URL ONLY. The Azure portal shows a full operation URL
# like https://<resource>.openai.azure.com/openai/responses?api-version=...
# — strip "/responses" and the "?api-version=" query string; the SDK adds
# both itself. Boot fails with a clear message if you paste the whole thing.
# DEPLOYMENT is the name you chose in the portal, not a public model name.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
# Per-user daily AI call caps (cost protection)
AI_DAILY_INTERPRET_LIMIT=50
AI_DAILY_COACH_LIMIT=100
# Google Sign-In. Both client ids are accepted as ID-token audiences: the
# native Android flow issues tokens for the WEB client id, while the Android
# client id authorises the app by package name + signing fingerprint.
# Without at least one of these set, /auth/google refuses every request
# rather than trusting an unverified token.
GOOGLE_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Not needed for sign-in — only for a future auth-code exchange.
GOOGLE_CLIENT_SECRET=
SPEECH_API_KEY=
# Free key: https://api.data.gov/signup/ (instant, no approval wait).
# Set this and MOCK_NUTRITION=false to look up real foods against USDA
# FoodData Central instead of the small built-in mock table.
NUTRITION_API_KEY=
