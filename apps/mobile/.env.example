EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_MOCK_SPEECH=true
# The WEB OAuth client id, not the Android one — the native sign-in library
# exchanges it for an ID token whose audience is this value. Not a secret:
# client ids are public, and the Android client is what actually restricts
# use to this app via package name + signing fingerprint.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
