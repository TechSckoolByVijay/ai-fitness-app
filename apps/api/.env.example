DATABASE_URL=postgresql://fitness:fitness@localhost:5433/fitness_app
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-long-random-string
PORT=4000

MOCK_AI=true
MOCK_SPEECH=true
MOCK_NUTRITION=true
MOCK_HEALTH_DATA=true

AI_API_KEY=
AI_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SPEECH_API_KEY=
# Free key: https://api.data.gov/signup/ (instant, no approval wait).
# Set this and MOCK_NUTRITION=false to look up real foods (e.g. "apple")
# against USDA FoodData Central instead of the ~12-item mock table.
NUTRITION_API_KEY=
