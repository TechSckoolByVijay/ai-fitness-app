DATABASE_URL=postgresql://fitness:fitness@localhost:5433/fitness_app
JWT_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-long-random-string
PORT=4000

MOCK_AI=true
MOCK_SPEECH=true
MOCK_NUTRITION=true
MOCK_HEALTH_DATA=true

# Which backend is live: 'openai' or 'azure'. Production runs 'azure'.
# Both blocks can be filled in at once — only AI_PROVIDER decides.
AI_PROVIDER=openai

# --- OpenAI (used when AI_PROVIDER=openai) ---
AI_API_KEY=
AI_MODEL=
# Leave unset for api.openai.com; set only to reach some other
# OpenAI-compatible endpoint. For Azure, use AI_PROVIDER=azure instead.
AI_BASE_URL=
# Only set alongside AI_BASE_URL for Azure resources using the classic
# (non-"/v1") endpoint shape — see the comment in openai.provider.ts.
AI_AZURE_API_VERSION=

# --- Azure OpenAI (used when AI_PROVIDER=azure) ---
# ENDPOINT is a base URL with no operation path and no query string.
# DEPLOYMENT is the alias you chose in the portal, not a public model name.
# Leave AZURE_OPENAI_API_VERSION EMPTY when the endpoint ends in /openai/v1
# (the newer OpenAI-compatible surface, and what production uses); setting
# it switches the SDK to the classic /openai/deployments/...?api-version=
# shape, which must be paired with an endpoint ending in /openai instead.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=
# Per-user daily AI call caps (cost protection)
AI_DAILY_INTERPRET_LIMIT=50
AI_DAILY_COACH_LIMIT=100
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SPEECH_API_KEY=
# Free key: https://api.data.gov/signup/ (instant, no approval wait).
# Set this and MOCK_NUTRITION=false to look up real foods (e.g. "apple")
# against USDA FoodData Central instead of the ~12-item mock table.
NUTRITION_API_KEY=
